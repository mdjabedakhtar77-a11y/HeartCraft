{
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://heartcraft-backend01.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://heartcraft-backend01.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads|assets|favicon.svg|icons.svg).*)",
      "destination": "/index.html"
    }
  ]
}
