{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://heartcraft-backend.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://heartcraft-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads|assets|favicon.svg|icons.svg).*)",
      "destination": "/index.html"
    }
  ]
}
